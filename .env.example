# Clave de Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Modelo a usar en /resumen-ia
OLLAMA_MODEL=nemotron-3-super:cloud

# URL base del servidor Ollama.
# Por defecto apunta a Ollama Cloud. Para un servidor local usar:
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=https://ollama.com/v1
