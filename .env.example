# Clave de Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Modelo a usar en /resumen-ia
OLLAMA_MODEL=nemotron-3-super:cloud

# URL base del servidor Ollama.
# Por defecto apunta a Ollama Cloud. Para un servidor local usar:
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=https://ollama.com/v1

#---servicios consultados para enriquecer el resumen---#
CLIENTES_URL=http://localhost:8082
VEHICULOS_URL=http://localhost:8083

#---kafka---#
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RESUMEN_SOLICITADO=resumen-solicitado
KAFKA_TOPIC_RESUMEN_GENERADO=resumen-generado
KAFKA_CONSUMER_GROUP=resumen-ia-service
KAFKA_CLIENT_ID=resumen-ia-microservice

#---kafka SASL/SSL (Aiven y brokers autenticados)---#
# Dejar vacío para brokers locales sin autenticación.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=ca.pem
