# Clave de Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=

# Modelo a usar en /resumen-ia
OLLAMA_MODEL=nemotron-3-super:cloud

# URL base del servidor Ollama.
# Por defecto apunta a Ollama Cloud. Para un servidor local usar:
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=https://ollama.com/v1

#---servicios consultados para enriquecer el resumen---#
CLIENTES_URL=http://localhost:8082
VEHICULOS_URL=http://localhost:8083
# Si las URLs de arriba apuntan al orquestador (http://localhost:8080/api): la clave de "ia-resumen"
# en CLAVES_SERVICIO del orquestador (32+ caracteres). Si se llama directo a los servicios, dejar vacía.
ORQUESTADOR_CLAVE_SERVICIO=

#---kafka---#
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Los tres tópicos del ecosistema (los mismos nombres en todos los servicios).
KAFKA_TOPICO_COMANDOS=crm.comandos
KAFKA_TOPICO_EVENTOS=crm.eventos
KAFKA_TOPICO_DLT=crm.dlt
KAFKA_CONSUMER_GROUP=resumen-ia-service
KAFKA_CLIENT_ID=resumen-ia-microservice

#---kafka SASL/SSL (Aiven y brokers autenticados)---#
# Dejar vacío para brokers locales sin autenticación.
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CAFILE=ca.pem
